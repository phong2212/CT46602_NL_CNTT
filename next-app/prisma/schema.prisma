generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Destinations {
  id          String @id @default(cuid()) @map("_id")
  name        String
  description String
  continent   String
  country     String
  city        String
  imageURL    String
}

enum UserRole {
  ADMIN
  USER
}

model Users {
  id        String   @id @default(cuid()) @map("_id")
  clerkId   String   @unique
  email     String   @unique
  photo     String   @unique
  firstName String?
  lastName  String?
  createdAt Float?
  role      UserRole @default(USER)
}
